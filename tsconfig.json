{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "lib": ["ES2023", "DOM"]
  },
  "include": ["src/interfaces/gui/gui.tsx", "src/interfaces/rpc/contract.js"]
}
